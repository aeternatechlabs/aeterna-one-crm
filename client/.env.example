# ==============================================================================
# Aeterna One CRM - Frontend Environment Configuration
# ==============================================================================

# Option 1: LOCAL DEVELOPMENT (Uses Vite Dev Proxy to localhost:5000)
# VITE_API_BASE_URL=/api/v1
# VITE_APP_TITLE=Aeterna One CRM

# Option 2: VERCEL PRODUCTION DEPLOYMENT
# In Vercel Project Settings -> Environment Variables, set:
# Name:  VITE_API_BASE_URL
# Value: https://your-backend-api.onrender.com/api/v1 (Replace with your actual backend URL)
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=Aeterna One CRM
