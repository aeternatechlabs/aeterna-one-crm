# ==============================================================================
# AETERNA ONE CRM - Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Connection
# Local MongoDB: mongodb://127.0.0.1:27017/aeterna_one_crm
# Atlas MongoDB: mongodb+srv://<username>:<password>@cluster.mongodb.net/aeterna_one_crm?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/aeterna_one_crm

# JWT Authentication (SEC-VULN-10 Hardened)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ABSOLUTE_SESSION_EXPIRES_IN_DAYS=30
REFRESH_GRACE_PERIOD_MS=30000

# Frontend CORS URLs (Explicit Allowlist)
# Multiple domains can be comma-separated: https://your-app.vercel.app,https://yourdomain.com
CLIENT_URL=http://localhost:3000
FRONTEND_URL=https://aeterna-one-crm.vercel.app
ALLOWED_ORIGINS=https://aeterna-one-crm.vercel.app

# Optional Vercel Preview Configuration (SEC-VULN-02 Hardened)
# Restricts preview origins to https://<VERCEL_PROJECT_NAME>-*.vercel.app
ALLOW_VERCEL_PREVIEWS=true
VERCEL_PROJECT_NAME=aeterna-one-crm

# Brevo (Sendinblue) Transactional Email Dispatcher
BREVO_API_KEY=your_brevo_api_key_v3
BREVO_SENDER_EMAIL=admissions@aeterna.com
BREVO_SENDER_NAME=Aeterna Education Consultancy
ENABLE_EMAIL_CONSOLE_LOG=true

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=aeterna-one-vault
# R2_PUBLIC_URL is strictly for designated public assets (public/*). Private student documents always use private AWS SigV4 presigned URLs.
R2_PUBLIC_URL=
R2_CUSTOM_DOMAIN=
STORAGE_SIGNING_SECRET=your_dedicated_storage_signing_secret_min_32_chars

# Distributed Rate Limiting & Proxy Configuration (SEC-VULN-08)
# In development, rate limiting uses in-memory storage by default (zero Redis required).
# In production multi-instance clusters, configure REDIS_URL to share rate-limit counters across nodes.
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_STORE=memory
REQUIRE_DISTRIBUTED_RATE_LIMIT=false
TRUST_PROXY=1

# Optional Integration Secrets (Planned Phases)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# GMAIL_USER=
# GMAIL_PASS=
